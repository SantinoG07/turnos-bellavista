# Copiar a .env y completar. NUNCA commitear el .env real.
# En producción usar una URL de Neon (o cualquier PostgreSQL) con SSL.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/turnos_bellavista
# Alternativa sin PostgreSQL instalado para desarrollo local: pglite://./.pgdata
# DATABASE_URL=pglite://./.pgdata

PORT=3000
NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

# Cambiar por un valor aleatorio largo en producción (mínimo 32 caracteres).
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
CORS_ORIGIN=http://localhost:5173

# Datos del administrador que crea `npm run seed`.
SEED_ADMIN_EMAIL=admin@bellavista.test
SEED_ADMIN_PASSWORD=Admin1234
SEED_ADMIN_NAME=Administración Bellavista
